# Copy to .env and fill in. Everything is optional for a first test run (demo mode + dry run).

# --- Your company ---
COMPANY_NAME=BrightPath Digital
COMPANY_TAGLINE=Websites, chatbots and automation for local businesses
OWNER_NAME=Alex
OWNER_EMAIL=you@gmail.com            # hot-lead alerts go here
OWNER_PHONE=
COMPANY_ADDRESS=123 Main St, Austin, TX 78701   # required by law (CAN-SPAM) before sending real emails

# --- App ---
PUBLIC_BASE_URL=http://localhost:8000          # your deployed URL, e.g. https://bizbot.onrender.com
DASHBOARD_PASSWORD=change-me

# --- Safety ---
DRY_RUN=true            # false = really send emails
DAILY_SEND_LIMIT=30
FOLLOWUP_DAYS=4
AUTOPILOT=false         # true = run the full cycle in the background
CYCLE_MINUTES=15

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (the API error will say so):
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-opus-5-5

# --- Google Places API (finding businesses) ---
GOOGLE_PLACES_API_KEY=

# --- Sending email (use a separate domain/inbox for outreach, e.g. Google Workspace or Zoho) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # for Gmail/Workspace use an App Password
FROM_EMAIL=

# --- Reading replies ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Phone alerts (optional) ---
NTFY_TOPIC=             # install the ntfy app and subscribe to a long random topic name
DISCORD_WEBHOOK_URL=
